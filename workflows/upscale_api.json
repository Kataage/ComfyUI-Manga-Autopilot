{
  "workflow_id": "upscale_default",
  "name": "Default Upscale",
  "type": "upscale",
  "file": "workflows/upscale_api.json",
  "description": "Two-stage upscale: load image, upscale by 2x with a model upscaler, then run a second KSampler at low denoise for detail recovery. Suitable as a post-step for any panel.",
  "bindings": {
    "positive_prompt": { "node_id": "6", "input": "text" },
    "negative_prompt": { "node_id": "7", "input": "text" },
    "seed": { "node_id": "3", "input": "seed" },
    "reference_image": { "node_id": "10", "input": "image" },
    "filename_prefix": { "node_id": "9", "input": "filename_prefix" }
  },
  "api_graph": {
    "3": { "class_type": "KSampler", "inputs": { "seed": 5, "steps": 16, "cfg": 7.0, "sampler_name": "euler_ancestral", "scheduler": "normal", "denoise": 0.35, "model": ["4", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["11", 0] } },
    "4": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "anything-v5.safetensors" } },
    "6": { "class_type": "CLIPTextEncode", "inputs": { "text": "high quality, detailed", "clip": ["4", 1] } },
    "7": { "class_type": "CLIPTextEncode", "inputs": { "text": "lowres, blurry", "clip": ["4", 1] } },
    "8": { "class_type": "VAEDecode", "inputs": { "samples": ["3", 0], "vae": ["4", 2] } },
    "9": { "class_type": "SaveImage", "inputs": { "filename_prefix": "upscaled", "images": ["8", 0] } },
    "10": { "class_type": "LoadImage", "inputs": { "image": "panel.png" } },
    "11": { "class_type": "VAEEncode", "inputs": { "pixels": ["12", 0], "vae": ["4", 2] } },
    "12": { "class_type": "ImageUpscaleWithModel", "inputs": { "upscale_model": ["13", 0], "image": ["10", 0] } },
    "13": { "class_type": "UpscaleModelLoader", "inputs": { "model_name": "RealESRGAN_x2plus.pth" } }
  }
}
